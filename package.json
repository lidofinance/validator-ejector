{
  "name": "validator-ejector",
  "version": "2.2.1",
  "private": true,
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@chainsafe/bls-keystore": "3.0.0",
    "@chainsafe/blst": "2.2.0",
    "@google-cloud/storage": "8.4.0",
    "@lodestar/params": "1.50.0",
    "@lodestar/types": "1.50.0",
    "@prometheus-io/client": "0.16.1",
    "dotenv": "18.0.8",
    "ethers": "5.8.0",
    "jsonwebtoken": "9.0.3",
    "lru-cache": "11.5.3",
    "node-fetch": "3.3.2"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "test:e2e": "vitest run --config vite.e2e.config.ts",
    "coverage": "vitest run --coverage --config vite.config.ts",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "encrypt": "tsx encryptor/encrypt.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "hardhat": "2.29.1",
    "nock": "15.0.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  },
  "resolutions": {
    "**/@chainsafe/bls-keystore/uuid": "11.1.1",
    "**/hardhat/uuid": "11.1.1",
    "**/hardhat/undici": "6.29.1",
    "**/hardhat/adm-zip": "0.6.1",
    "**/solc/tmp": "0.2.7",
    "**/mocha/diff": "8.0.4",
    "**/mocha/serialize-javascript": "7.1.2",
    "**/@sentry/node/cookie": "0.7.2",
    "**/@ethersproject/providers/ws": "8.22.0"
  }
}
